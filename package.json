{
  "name": "jquery-mockjax",
  "title": "jQuery Mockjax",
  "version": "3.0.0",
  "main": "./dist/jquery.mockjax.js",
  "module": "./src/index.js",
  "description": "The jQuery Mockjax Plugin provides a simple and extremely flexible interface for mocking or simulating ajax requests and responses.",
  "url": "https://github.com/jakerella/jquery-mockjax",
  "scripts": {
    "build": "npx webpack --mode production --config webpack.config.mjs",
    "test": "npm run test:unit && npm run test:integration:all",
    "test:unit": "npx qunit test/unit/*-test.js",
    "test:integration:all": "node test/headless-runner.js all",
    "test:integration:latest": "node test/headless-runner.js latest",
    "test:nodejs": "npx mocha test/nodejs/test.cjs",
    "test:requirejs": "node test/requirejs/headless-require.js",
    "test:headless": "npm run test:integration:latest && npm run test:nodejs && npm run test:requirejs",
    "lint": "npx eslint",
    "lint:fix": "npx eslint --fix",
    "format": "npx prettier --write \"src/**/*.mjs\" \"test/**/*.js\"",
    "format:check": "npx prettier --check \"src/**/*.mjs\" \"test/**/*.js\"",
    "watch:build": "npx npm-watch build",
    "watch:test": "npx npm-watch test:integration:latest"
  },
  "watch": {
    "build": {
      "patterns": [
        "src",
        "webpack.config.mjs",
        "webpack.custom-umd.mjs"
      ],
      "extensions": "mjs",
      "delay": 1500
    },
    "test:integration:latest": {
      "patterns": [
        "src",
        "test"
      ],
      "extensions": "mjs,js,json,html",
      "delay": 1500
    }
  },
  "keywords": [
    "ajax",
    "mock",
    "unit",
    "testing",
    "jquery-plugin",
    "ecosystem:jquery"
  ],
  "author": {
    "name": "Jordan Kasper",
    "url": "http://jordankasper.com"
  },
  "contributors": [
    {
      "name": "Doug Neiner"
    },
    {
      "name": "Jonathan Creamer"
    },
    {
      "name": "Jonathan Sharp",
      "url": "http://jdsharp.com"
    }
  ],
  "homepage": "https://github.com/jakerella/jquery-mockjax",
  "repository": {
    "type": "git",
    "url": "https://github.com/jakerella/jquery-mockjax.git"
  },
  "bugs": {
    "web": "http://github.com/jakerella/jquery-mockjax/issues"
  },
  "licenses": [
    {
      "type": "MIT",
      "url": "http://opensource.org/licenses/MIT"
    }
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "browserify": "^17.0.0",
    "browserstack-runner": "^0.9.4",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.7.1",
    "globals": "^17.4.0",
    "http-server": "^14.1.1",
    "jsdom": "^28.1.0",
    "mocha": "^11.7.5",
    "npm-watch": "^0.13.0",
    "nyc": "^18.0.0",
    "prettier": "^3.8.1",
    "puppeteer": "^22.1.0",
    "qunit": "^2.25.0",
    "qunit-puppeteer": "^1.0.1",
    "requirejs": "^2.3.8",
    "sinon": "^21.0.2",
    "terser-webpack-plugin": "^5.3.17",
    "webpack": "^5.105.4",
    "webpack-cli": "^6.0.1",
    "xmlhttprequest": "^1.8.0"
  },
  "peerDependencies": {
    "jquery1": "npm:jquery@^1.12.4",
    "jquery2": "npm:jquery@^2.2.4",
    "jquery3": "npm:jquery@^3.7.1",
    "jquery4": "npm:jquery@^4.0.0"
  }
}
